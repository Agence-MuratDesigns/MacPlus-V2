<script>
  (function() {
    // Ferme les dropdowns au clic extérieur
    document.addEventListener('click', function(e) {
      document.querySelectorAll('.tf-group[open]').forEach(function(el) {
        if (!el.contains(e.target)) el.removeAttribute('open');
      });
    });
    // Ferme les autres dropdowns quand on en ouvre un
    document.querySelectorAll('.tf-group').forEach(function(group) {
      group.addEventListener('toggle', function() {
        if (this.open) {
          document.querySelectorAll('.tf-group[open]').forEach(function(el) {
            if (el !== group) el.removeAttribute('open');
          });
        }
      });
    });
  })();
</script>
