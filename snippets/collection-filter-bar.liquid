{% comment %}
  Inline horizontal filter bar for collection page
  Displays category filters and price range as dropdown buttons
{% endcomment %}

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    padding: 20px 0;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
    margin-bottom: 20px;
  }
  .filter-bar__title {
    font-size: 1.4rem;
    font-weight: 600;
    color: rgba(var(--color-foreground), 0.7);
    margin-right: 10px;
  }
  .filter-bar__group {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .filter-bar__dropdown {
    position: relative;
  }
  .filter-bar__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    font-size: 1.4rem;
    font-weight: 500;
    color: rgba(var(--color-foreground), 0.85);
    background: rgba(var(--color-foreground), 0.03);
    border: 1px solid rgba(var(--color-foreground), 0.12);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
  }
  .filter-bar__btn:hover {
    background: rgba(var(--color-foreground), 0.08);
    border-color: rgba(var(--color-foreground), 0.2);
  }
  .filter-bar__btn.active {
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    border-color: rgb(var(--color-foreground));
  }
  .filter-bar__btn svg {
    width: 12px;
    height: 12px;
    transition: transform 0.2s ease;
  }
  .filter-bar__dropdown[open] .filter-bar__btn svg {
    transform: rotate(180deg);
  }
  .filter-bar__menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 220px;
    max-height: 300px;
    overflow-y: auto;
    background: rgb(var(--color-background));
    border: 1px solid rgba(var(--color-foreground), 0.1);
    border-radius: 12px;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.12);
    z-index: 100;
    padding: 10px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.25s ease;
  }
  .filter-bar__dropdown[open] .filter-bar__menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .filter-bar__option {
    display: flex;
    align-items: center;
    padding: 10px 14px;
    font-size: 1.4rem;
    color: rgba(var(--color-foreground), 0.85);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
  }
  .filter-bar__option:hover {
    background: rgba(var(--color-foreground), 0.05);
    padding-left: 18px;
  }
  .filter-bar__option.selected {
    background: rgba(var(--color-foreground), 0.08);
    font-weight: 600;
  }
  .filter-bar__option input[type="checkbox"] {
    margin-right: 10px;
    accent-color: rgb(var(--color-foreground));
  }
  .filter-bar__option-count {
    margin-left: auto;
    font-size: 1.2rem;
    color: rgba(var(--color-foreground), 0.5);
  }
  .filter-bar__price-inputs {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 10px;
  }
  .filter-bar__price-field {
    position: relative;
    flex: 1;
  }
  .filter-bar__price-field label {
    display: block;
    font-size: 1.1rem;
    color: rgba(var(--color-foreground), 0.6);
    margin-bottom: 4px;
  }
  .filter-bar__price-field input {
    width: 100%;
    padding: 8px 10px 8px 24px;
    border: 1px solid rgba(var(--color-foreground), 0.15);
    border-radius: 6px;
    font-size: 1.3rem;
    background: transparent;
  }
  .filter-bar__price-field input:focus {
    outline: none;
    border-color: rgb(var(--color-foreground));
  }
  .filter-bar__price-field .currency {
    position: absolute;
    left: 10px;
    bottom: 9px;
    font-size: 1.2rem;
    color: rgba(var(--color-foreground), 0.5);
  }
  .filter-bar__apply-btn {
    width: 100%;
    padding: 10px;
    margin-top: 8px;
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    border: none;
    border-radius: 6px;
    font-size: 1.3rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  .filter-bar__apply-btn:hover {
    opacity: 0.85;
  }
  .filter-bar__clear {
    font-size: 1.3rem;
    color: rgba(var(--color-foreground), 0.6);
    text-decoration: underline;
    cursor: pointer;
    margin-left: auto;
    background: none;
    border: none;
    padding: 10px 16px;
  }
  .filter-bar__clear:hover {
    color: rgb(var(--color-foreground));
  }
  .filter-bar__active-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }
  .filter-bar__active-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    font-size: 1.2rem;
    background: rgba(var(--color-foreground), 0.08);
    border-radius: 20px;
    color: rgba(var(--color-foreground), 0.85);
    text-decoration: none;
  }
  .filter-bar__active-tag:hover {
    background: rgba(var(--color-foreground), 0.15);
  }
  .filter-bar__active-tag svg {
    width: 10px;
    height: 10px;
  }
  @media (max-width: 991px) {
    .filter-bar {
      display: none;
    }
  }
</style>

{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign total_active_values = 0
  if collection.url
    assign results_url = collection.url
  endif
-%}

<facet-filters-form>
  <form id="FilterBarForm" class="filter-bar-form">
    {%- if collection.terms -%}
      <input type="hidden" name="q" value="{{ collection.terms | escape }}">
      <input name="options[prefix]" type="hidden" value="last">
    {%- endif -%}

    <div class="filter-bar">
      <span class="filter-bar__title">{{ 'products.facets.filter_by_label' | t }}</span>

      <div class="filter-bar__group">
        {%- for filter in collection.filters -%}
          {%- assign total_active_values = total_active_values | plus: filter.active_values.size -%}

          {% case filter.type %}
            {% when 'boolean', 'list' %}
              <details class="filter-bar__dropdown" id="FilterBar-{{ filter.label | handle }}">
                <summary class="filter-bar__btn {% if filter.active_values.size > 0 %}active{% endif %}">
                  {{ filter.label | escape }}
                  {% if filter.active_values.size > 0 %}
                    ({{ filter.active_values.size }})
                  {% endif %}
                  <svg viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </summary>
                <div class="filter-bar__menu">
                  {%- for value in filter.values -%}
                    {%- if value.count > 0 or value.active -%}
                      <label class="filter-bar__option {% if value.active %}selected{% endif %}">
                        <input
                          type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          {% if value.active %}checked{% endif %}
                          {% if value.count == 0 and value.active == false %}disabled{% endif %}
                        >
                        {{ value.label | escape }}
                        <span class="filter-bar__option-count">({{ value.count }})</span>
                      </label>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </details>

            {% when 'price_range' %}
              {% liquid
                assign currencies_using_comma_decimals = 'ANG,ARS,BRL,BYN,BYR,CLF,CLP,COP,CRC,CZK,DKK,EUR,HRK,HUF,IDR,ISK,MZN,NOK,PLN,RON,RUB,SEK,TRY,UYU,VES,VND' | split: ','
                assign uses_comma_decimals = false
                if currencies_using_comma_decimals contains cart.currency.iso_code
                  assign uses_comma_decimals = true
                endif
              %}
              <details class="filter-bar__dropdown" id="FilterBar-price">
                <summary class="filter-bar__btn {% if filter.min_value.value != nil or filter.max_value.value != nil %}active{% endif %}">
                  {{ filter.label | escape }}
                  {% if filter.min_value.value != nil or filter.max_value.value != nil %}
                    (1)
                  {% endif %}
                  <svg viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </summary>
                <div class="filter-bar__menu">
                  <price-range class="filter-bar__price-inputs">
                    <div class="filter-bar__price-field">
                      <label for="FilterBar-price-min">{{ 'sections.collection_template.from' | t }}</label>
                      <span class="currency">{{ cart.currency.symbol }}</span>
                      <input
                        type="number"
                        name="{{ filter.min_value.param_name }}"
                        id="FilterBar-price-min"
                        placeholder="0"
                        min="0"
                        {%- if filter.min_value.value -%}
                          {%- if uses_comma_decimals -%}
                            value="{{ filter.min_value.value | money_without_currency | replace: '.', '' | replace: ',', '.' }}"
                          {%- else -%}
                            value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                          {%- endif %}
                        {%- endif -%}
                        {%- if uses_comma_decimals -%}
                          max="{{ filter.range_max | money_without_currency | replace: '.', '' | replace: ',', '.' }}"
                        {%- else -%}
                          max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                        {% endif %}
                      >
                    </div>
                    <span>-</span>
                    <div class="filter-bar__price-field">
                      <label for="FilterBar-price-max">{{ 'sections.collection_template.to' | t }}</label>
                      <span class="currency">{{ cart.currency.symbol }}</span>
                      <input
                        type="number"
                        name="{{ filter.max_value.param_name }}"
                        id="FilterBar-price-max"
                        min="0"
                        {%- if filter.max_value.value -%}
                          {%- if uses_comma_decimals -%}
                            value="{{ filter.max_value.value | money_without_currency | replace: '.', '' | replace: ',', '.' }}"
                          {%- else -%}
                            value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                          {%- endif %}
                        {%- endif -%}
                        {%- if uses_comma_decimals -%}
                          placeholder="{{ filter.range_max | money_without_currency | replace: '.', '' | replace: ',', '.' }}"
                          max="{{ filter.range_max | money_without_currency | replace: '.', '' | replace: ',', '.' }}"
                        {%- else -%}
                          placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                          max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                        {% endif %}
                      >
                    </div>
                  </price-range>
                </div>
              </details>
          {% endcase %}
        {%- endfor -%}
      </div>

      {%- if total_active_values > 0 -%}
        <a href="{{ results_url }}" class="filter-bar__clear">
          {{ 'products.facets.clear_all' | t }}
        </a>
      {%- endif -%}
    </div>

    {%- if total_active_values > 0 -%}
      <div class="filter-bar__active-filters">
        {%- for filter in collection.filters -%}
          {%- for value in filter.active_values -%}
            <a href="{{ value.url_to_remove }}" class="filter-bar__active-tag">
              {{ filter.label }}: {{ value.label | escape }}
              <svg viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 1L9 9M9 1L1 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </a>
          {%- endfor -%}
          {% if filter.type == 'price_range' %}
            {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
              <a href="{{ filter.url_to_remove }}" class="filter-bar__active-tag">
                {%- if filter.min_value.value -%}{{ filter.min_value.value | money }}{%- else -%}{{ 0 | money }}{%- endif -%}
                -
                {%- if filter.max_value.value -%}{{ filter.max_value.value | money }}{%- else -%}{{ filter.range_max | money }}{%- endif -%}
                <svg viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 1L9 9M9 1L1 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </a>
            {%- endif -%}
          {% endif %}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {% if collection.current_vendor or collection.current_type %}
      <input type="hidden" name="q" value="{{ collection.current_vendor }}{{ collection.current_type }}">
    {% endif %}
  </form>
</facet-filters-form>

<script>
  // Close dropdown when clicking outside
  document.addEventListener('click', function(e) {
    document.querySelectorAll('.filter-bar__dropdown[open]').forEach(function(dropdown) {
      if (!dropdown.contains(e.target)) {
        dropdown.removeAttribute('open');
      }
    });
  });
</script>
