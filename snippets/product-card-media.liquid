<div
  class="media media--transparent media--{{ media_size }} media--hover-effect"
  {% if media_size == 'adapt' and product_card_product.featured_media %}
    style="padding-bottom: {{ 1 | divided_by: featured_media_aspect_ratio | times: 100 }}%;"
  {% endif %}
>
  {%- liquid
    assign second_img_position = product_card_product.featured_media.position
    assign second_img_position = second_img_position | plus: 1
  -%}
  <img
    srcset="
      {%- if product_card_product.featured_media.width >= 360 -%}{{ product_card_product.featured_media | img_url: '360x' }} 360w,{%- endif -%}
      {%- if product_card_product.featured_media.width >= 540 -%}{{ product_card_product.featured_media | img_url: '540x' }} 540w,{%- endif -%}
      {%- if product_card_product.featured_media.width >= 720 -%}{{ product_card_product.featured_media | img_url: '720x' }} 720w,{%- endif -%}
      {%- if product_card_product.featured_media.width >= 900 -%}{{ product_card_product.featured_media | img_url: '900x' }} 900w,{%- endif -%}
      {%- if product_card_product.featured_media.width >= 1080 -%}{{ product_card_product.featured_media | img_url: '1080x' }} 1080w,{%- endif -%}
      {%- if product_card_product.featured_media.width >= 1296 -%}{{ product_card_product.featured_media | img_url: '1296x' }} 1296w,{%- endif -%}
      {%- if product_card_product.featured_media.width >= 1512 -%}{{ product_card_product.featured_media | img_url: '1512x' }} 1512w{%- endif -%}
    "
    src="{{ product_card_product.featured_media | img_url: '720x' }}"
    sizes="(min-width: 1400px) 400px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
    alt="{{ product_card_product.featured_media.alt | escape }}"
    loading="lazy"
    class="motion-reduce"
    width="{{ product_card_product.featured_media.width }}"
    height="{{ product_card_product.featured_media.height }}"
    data-media-id="{{ section.id }}-{{ product_card_product.featured_media.id }}"
  >

  {%- if product_card_product.media[second_img_position] != null and show_secondary_image -%}
    <img
      srcset="
        {%- if product_card_product.media[second_img_position].width >= 360 -%}{{ product_card_product.media[second_img_position] | img_url: '360x' }} 360w,{%- endif -%}
        {%- if product_card_product.media[second_img_position].width >= 540 -%}{{ product_card_product.media[second_img_position] | img_url: '540x' }} 540w,{%- endif -%}
        {%- if product_card_product.media[second_img_position].width >= 720 -%}{{ product_card_product.media[second_img_position] | img_url: '720x' }} 720w,{%- endif -%}
        {%- if product_card_product.media[second_img_position].width >= 900 -%}{{ product_card_product.media[second_img_position] | img_url: '900x' }} 900w,{%- endif -%}
        {%- if product_card_product.media[second_img_position].width >= 1080 -%}{{ product_card_product.media[second_img_position] | img_url: '1080x' }} 1080w,{%- endif -%}
        {%- if product_card_product.media[second_img_position].width >= 1296 -%}{{ product_card_product.media[second_img_position] | img_url: '1296x' }} 1296w,{%- endif -%}
        {%- if product_card_product.media[second_img_position].width >= 1512 -%}{{ product_card_product.media[second_img_position] | img_url: '1512x' }} 1512w{%- endif -%}
      "
      src="{{ product_card_product.media[second_img_position] | img_url: '720x' }}"
      sizes="(min-width: 1400px) 400px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
      alt="{{ product_card_product.media[second_img_position].alt | escape }}"
      loading="lazy"
      class="motion-reduce secondary__img"
      width="{{ product_card_product.media[second_img_position].width }}"
      height="{{ product_card_product.media[second_img_position].height }}"
      data-media-id="{{ section.id }}-{{ product_card_product.media[second_img_position].id }}"
    >
  {%- endif -%}
</div>
